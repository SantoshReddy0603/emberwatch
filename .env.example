# Server
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/emberwatch
JWT_SECRET=change-me-to-a-long-random-string
FLEET_SECRET=change-me-fleet-provisioning-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000,http://127.0.0.1:4000
RAW_TTL_MINUTES=360
ROLLUP_TTL_HOURS=24
DEMO_PASSWORD=ember-demo

# Create the fleet, gateway keys and demo accounts on every boot (safe to repeat)
SEED_ON_START=0

# Run the simulator inside the server process (useful on single-service hosts)
SIM_EMBEDDED=0
SIM_HZ=2

# Simulator (standalone)
SIM_URL=http://localhost:4000
