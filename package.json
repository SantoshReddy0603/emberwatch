{
  "name": "emberwatch",
  "private": true,
  "version": "1.0.0",
  "description": "Real-time wildfire early-warning telemetry platform",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "simulator",
    "client",
    "bench"
  ],
  "scripts": {
    "start": "node server/src/index.js",
    "db": "node scripts/devdb.js",
    "seed": "npm run seed -w server",
    "server": "npm run dev -w server",
    "sim": "npm start -w simulator --",
    "client": "npm run dev -w client",
    "dev": "concurrently -n server,sim,client -c yellow,magenta,cyan \"npm run server\" \"npm run sim\" \"npm run client\"",
    "test": "npm test -w server && npm test -w client",
    "build": "npm run build -w client",
    "bench": "npm start -w bench --"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "mongodb-memory-server": "^11.3.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
